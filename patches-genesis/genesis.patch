+#!/bin/bash
+
+cat <<"EOF"
+
+  /$$$$$$                                          /$$                 /$$         /$$       
+ /$$__  $$                                        |__/                | $$       /$$$$       
+| $$  \__/  /$$$$$$  /$$$$$$$   /$$$$$$   /$$$$$$$ /$$  /$$$$$$$      | $$      |_  $$       
